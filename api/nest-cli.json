{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": false,
    "assets": [
      {
        "include": "providers/mail/templates/**/*",
        "outDir": "dist"
      },
      {
        "include": "i18n/*",
        "outDir": "dist"
      },
      {
        "include": "**/*.hbs",
        "outDir": "dist"
      },
      {
        "include": "**/*.html",
        "outDir": "dist"
      }
    ],
    "watchAssets": false
  }
}