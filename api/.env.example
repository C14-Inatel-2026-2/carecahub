# // Server
NODE_ENV='development'

ENV_SCOPE='local'

PORT=3030

DOMAIN_URL='http://localhost:3030'

WEB_URL='http://localhost:5173'

API_URL='http://localhost:3030'

PRETTY_LOG=true


# // Storage
DATABASE_URL="postgresql://root:root@localhost:5432/ignite?schema=public"
CACHE_ADDR='redis://localhost:6379'


# // AWS
AWS_REGION='us-east-1'

AWS_PUBLIC_BUCKET='my-bucket'

AWS_PRIVATE_BUCKET='my-private-bucket'

AWS_ACCESS_KEY_ID='access-key-id'

AWS_SECRET_ACCESS_KEY='secret-access-key'


# // Security
API_SECRET='api-secret'

JWT_SECRET='jwt-secret'


# // Mail
MAIL_ENABLED=false

MAIL_HOST='smtp.example.com'

MAIL_PORT=587

MAIL_USER='user@example.com'

MAIL_PASS='password'

MAIL_FROM='Admin Example <admin@example.com>'
