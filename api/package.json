  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "NODE_ENV=test tsx --test src/**/*.test.ts",
    "test:utils": "NODE_ENV=test tsx --test src/utils/*.test.ts",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "db:g": "drizzle-kit generate",
    "db:m": "drizzle-kit migrate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "drizzle-kit migrate",
    "db:clear": "docker compose stop carecahub_db && docker compose rm -f carecahub_db && docker volume rm api_carecahub_pg_vol && docker compose up -d carecahub_db",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main"
  },
  "dependencies": {
