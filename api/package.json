    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
