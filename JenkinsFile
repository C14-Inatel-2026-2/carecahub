pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    environment {
        API_CHANGED = 'false'
        WEB_CHANGED = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup pnpm') {
            steps {
                sh 'pnpm --version'
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    sh "git fetch origin ${env.CHANGE_TARGET}"

                    def changedFiles = sh(
                        script: "git diff --name-only origin/${env.CHANGE_TARGET}...HEAD",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:"
                    echo changedFiles

                    def files = changedFiles.readLines()

                    env.API_CHANGED = files.any {
                        it.startsWith('api/')
                    }.toString()

                    env.WEB_CHANGED = files.any {
                        it.startsWith('web/')
                    }.toString()

                    echo "API changed: ${env.API_CHANGED}"
                    echo "Web changed: ${env.WEB_CHANGED}"
                }
            }
        }

        stage('Validate') {
            parallel {
                stage('API') {
                    when {
                        expression {
                            env.API_CHANGED == 'true'
                        }
                    }

                    stages {
                        stage('Install') {
                            steps {
                                dir('api') {
                                    sh 'pnpm install --frozen-lockfile'
                                }
                            }
                        }

                        stage('Lint') {
                            steps {
                                dir('api') {
                                    sh 'pnpm lint'
                                }
                            }
                        }

                        stage('Test') {
                            steps {
                                dir('api') {
                                    dir('reports') { deleteDir() }
                                    sh 'pnpm test --reporter=default --reporter=junit --outputFile=reports/junit.xml'
                                }
                            }
                            post {
                                always {
                                    junit 'api/reports/junit.xml'
                                }
                            }
                        }

                        stage('Build') {
                            steps {
                                dir('api') {
                                    sh 'pnpm build'
                                }
                            }
                        }
                    }
                }

                stage('Web') {
                    when {
                        expression {
                            env.WEB_CHANGED == 'true'
                        }
                    }

                    stages {
                        stage('Install') {
                            steps {
                                dir('web') {
                                    sh 'pnpm install --frozen-lockfile'
                                }
                            }
                        }

                        stage('Lint') {
                            steps {
                                dir('web') {
                                    sh 'pnpm lint'
                                }
                            }
                        }

                        stage('Test') {
                            steps {
                                dir('web') {
                                    dir('reports') { deleteDir() }
                                    sh 'pnpm test --reporter=default --reporter=junit --outputFile=reports/junit.xml'
                                }
                            }
                            post {
                                always {
                                    junit 'web/reports/junit.xml'
                                }
                            }
                        }

                        stage('Build') {
                            steps {
                                dir('web') {
                                    sh 'pnpm build'
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
