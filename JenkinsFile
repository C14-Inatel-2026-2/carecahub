pipeline {
    agent any

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    parameters {
        booleanParam(name: 'DEPLOY_RENDER', defaultValue: false, description: 'Aplicar migrations no Supabase e publicar no Render após validar o commit')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup pnpm') {
            steps {
                sh 'pnpm --version'
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    if (!env.CHANGE_TARGET) {
                        env.API_CHANGED = 'true'
                        env.WEB_CHANGED = 'true'
                        echo 'Branch build: validating API and Web.'
                        return
                    }

                    sh "git fetch origin ${env.CHANGE_TARGET}"

                    def changedFiles = sh(
                        script: "git diff --name-only origin/${env.CHANGE_TARGET}...HEAD",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:"
                    echo changedFiles

                    def files = changedFiles.readLines()

                    env.API_CHANGED = files.any {
                        it.startsWith('api/')
                    }.toString()

                    env.WEB_CHANGED = files.any {
                        it.startsWith('web/')
                    }.toString()

                    echo "API changed: ${env.API_CHANGED}"
                    echo "Web changed: ${env.WEB_CHANGED}"
                }
            }
        }

        stage('Validate') {
            parallel {
                stage('API') {
                    when {
                        expression {
                            env.API_CHANGED == 'true'
                        }
                    }

                    stages {
                        stage('Install') {
                            steps {
                                dir('api') {
                                    sh 'pnpm install --frozen-lockfile'
                                }
                            }
                        }

                        stage('Lint') {
                            steps {
                                dir('api') {
                                    sh 'pnpm lint'
                                }
                            }
                        }

                        stage('Test') {
                            steps {
                                dir('api') {
                                    dir('reports') { deleteDir() }
                                    sh 'pnpm test --reporter=default --reporter=junit --outputFile=reports/junit.xml'
                                }
                            }
                            post {
                                always {
                                    junit 'api/reports/junit.xml'
                                }
                            }
                        }

                        stage('Build') {
                            steps {
                                dir('api') {
                                    sh 'pnpm build'
                                }
                            }
                        }
                    }
                }

                stage('Web') {
                    when {
                        expression {
                            env.WEB_CHANGED == 'true'
                        }
                    }

                    stages {
                        stage('Install') {
                            steps {
                                dir('web') {
                                    sh 'pnpm install --frozen-lockfile'
                                }
                            }
                        }

                        stage('Lint') {
                            steps {
                                dir('web') {
                                    sh 'pnpm lint'
                                }
                            }
                        }

                        stage('Test') {
                            steps {
                                dir('web') {
                                    dir('reports') { deleteDir() }
                                    sh 'pnpm test --reporter=default --reporter=junit --outputFile=reports/junit.xml'
                                }
                            }
                            post {
                                always {
                                    junit 'web/reports/junit.xml'
                                }
                            }
                        }

                        stage('Build') {
                            steps {
                                dir('web') {
                                    sh 'pnpm build'
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy Render') {
            when {
                allOf {
                    expression { params.DEPLOY_RENDER }
                    not { changeRequest() }
                    branch 'main'
                }
            }
            stages {
                stage('Migrate Supabase') {
                    steps {
                        timeout(time: 5, unit: 'MINUTES') {
                            withCredentials([
                                string(credentialsId: 'supabase-database-url', variable: 'DATABASE_URL'),
                                file(credentialsId: 'supabase-database-ca', variable: 'NODE_EXTRA_CA_CERTS')
                            ]) {
                                dir('api') {
                                    sh '''
                                        set +x
                                        pnpm db:migrate
                                    '''
                                }
                            }
                        }
                    }
                }

                stage('Publish API and Web') {
                    steps {
                        timeout(time: 20, unit: 'MINUTES') {
                            withCredentials([
                                string(credentialsId: 'render-api-key', variable: 'RENDER_API_KEY'),
                                string(credentialsId: 'render-api-service-id', variable: 'RENDER_API_SERVICE_ID'),
                                string(credentialsId: 'render-web-service-id', variable: 'RENDER_WEB_SERVICE_ID')
                            ]) {
                                sh 'node jenkins/deploy-render.mjs "$(git rev-parse HEAD)"'
                            }
                        }
                    }
                }
            }
        }
    }
}
