pipeline {
    agent none

    options {
        timestamps()
    }

    environment {
        API_CHANGED = 'false'
        WEB_CHANGED = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup pnpm') {
            steps {
                sh 'corepack enable'
            }
        }

        stage('Detect Changes') {
            agent {
                label 'pnpm-node'
            }
            steps {
                script {
                    sh "git fetch origin ${env.CHANGE_TARGET}"

                    def changedFiles = sh(
                        script: "git diff --name-only origin/${env.CHANGE_TARGET}...HEAD",
                        returnStdout: true
                    ).trim()

                    echo "Changed files:"
                    echo changedFiles

                    def files = changedFiles.readLines()

                    env.API_CHANGED = files.any {
                        it.startsWith('api/')
                    }.toString()

                    env.WEB_CHANGED = files.any {
                        it.startsWith('web/')
                    }.toString()

                    echo "API changed: ${env.API_CHANGED}"
                    echo "Web changed: ${env.WEB_CHANGED}"
                }
            }
        }

        stage('Validate') {
            parallel {
                stage('API') {
                    when {
                        expression {
                            env.API_CHANGED == 'true'
                        }
                    }

                    agent {
                        label 'pnpm-node'
                    }

                    stages {
                        stage('Install') {
                            steps {
                                // [API] STEP 1: Install
                            }
                        }

                        stage('Lint') {
                            steps {
                                // [API] STEP 2: Lint
                            }
                        }

                        stage('Test') {
                            steps {
                                // [API] STEP 3: Test
                            }
                        }

                        stage('Build') {
                            steps {
                                // [API] STEP 4: Build
                            }
                        }
                    }
                }

                stage('Web') {
                    when {
                        expression {
                            env.WEB_CHANGED == 'true'
                        }
                    }

                    agent {
                        label 'pnpm-node'
                    }

                    stages {
                        stage('Install') {
                            steps {
                                // [WEB] STEP 1: Install
                            }
                        }

                        stage('Lint') {
                            steps {
                                // [WEB] STEP 2: Lint
                            }
                        }

                        stage('Test') {
                            steps {
                                // [WEB] STEP 3: Test
                            }
                        }

                        stage('Build') {
                            steps {
                                // [WEB] STEP 4: Build
                            }
                        }
                    }
                }
            }
        }
    }
}